{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "composite": true,
    "paths": {
      "@base-ui/remix": ["../base-ui/packages/remix/src/index.ts"],
      "@base-ui/remix/*": ["../base-ui/packages/remix/src/*/index.ts"]
    }
  },
  "include": ["src", "../base-ui/packages/remix/src"]
}
