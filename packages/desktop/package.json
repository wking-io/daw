{
	"name": "@daw/desktop",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"predev": "bun ./scripts/predev.ts",
		"prebuild": "bun ./scripts/predev.ts",
		"dev": "bun ./server/dev.ts",
		"build": "bun run typecheck",
		"tauri": "tauri",
		"test:js": "bun test ./scripts",
		"test:rust": "bun ./scripts/test-rust.ts",
		"test": "bun run test:js && bun run test:rust",
		"rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
		"rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
		"rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"fmt": "biome check --write ."
	},
	"dependencies": {
		"@daw/app-remix": "workspace:*",
		"@remix-run/component": "catalog:",
		"@remix-run/interaction": "catalog:"
	},
	"devDependencies": {
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"@biomejs/biome": "catalog:",
		"typescript": "catalog:"
	}
}
