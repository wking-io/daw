{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "DAW",
	"version": "../package.json",
	"identifier": "com.daw.desktop",
	"build": {
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"bundle": {
		"externalBin": ["sidecars/daw-mcp", "sidecars/daw-server"]
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "DAW",
				"hiddenTitle": true,
				"titleBarStyle": "Overlay",
				"maximized": true,
				"resizable": true,
				"visible": true
			}
		],
		"withGlobalTauri": true,
		"security": {
			"csp": null
		},
		"macOSPrivateApi": true
	}
}
