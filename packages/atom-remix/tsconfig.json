{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component",
    "skipLibCheck": true,
    "strict": true,
    "types": ["bun"],
    "noEmit": true
  },
  "include": ["src"]
}
