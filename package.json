{
	"name": "daw",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"packageManager": "bun@1.3.5",
	"catalog": {
		"oxlint": "1.42.0",
		"oxfmt": "0.27.0",
		"@effect/opentelemetry": "0.42.1",
		"@opentelemetry/api": "1.9.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.57.2",
		"@opentelemetry/resources": "1.30.1",
		"@opentelemetry/sdk-trace-base": "1.30.1",
		"@opentelemetry/sdk-trace-node": "1.30.1",
		"@opentelemetry/sdk-trace-web": "1.30.1",
		"@opentelemetry/semantic-conventions": "1.28.0",
		"@effect-atom/atom": "0.4.12",
		"@effect-atom/atom-react": "0.4.5",
		"@effect/ai": "0.33.2",
		"@effect/experimental": "0.58.0",
		"@effect/platform": "0.94.1",
		"@effect/platform-bun": "0.87.0",
		"@effect/rpc": "0.73.0",
		"@effect/sql": "0.49.0",
		"@effect/sql-sqlite-bun": "0.50.0",
		"@remix-run/component": "0.3.0",
		"@remix-run/interaction": "0.4.0",
		"@remix-run/route-pattern": "0.17.0",
		"@tauri-apps/api": "2.9.1",
		"@tauri-apps/cli": "2.9.6",
		"@tsconfig/bun": "1.0.8",
		"@types/bun": "1.2.21",
		"@types/node": "24.3.1",
		"@types/react": "19.2.8",
		"@types/react-dom": "19.2.3",
		"@types/scheduler": "0.26.0",
		"@tailwindcss/cli": "4.1.18",
		"@tailwindcss/vite": "4.1.18",
		"@vitejs/plugin-react": "5.1.2",
		"@vitest/coverage-v8": "4.0.16",
		"effect": "3.19.14",
		"scheduler": "0.27.0",
		"tailwindcss": "4.1.18",
		"ulid": "3.0.2",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"typescript": "5.9.3",
		"vite": "7.1.4",
		"vitest": "4.0.16",
		"turbo": "2.5.0"
	},
	"scripts": {
		"preinstall": "bun ./scripts/ensure-bun.ts",
		"typecheck": "bun turbo typecheck",
		"fmt": "bun turbo fmt",
		"lint": "bun turbo lint",
		"check": "bun run typecheck && bun run lint && bun run --cwd packages/desktop rust:check",
		"test": "turbo run test",
		"test:ci": "bun run test && bun run --cwd packages/app test:e2e",
		"dev:app": "bun run --cwd packages/app dev",
		"dev:desktop": "bun run --cwd packages/desktop tauri dev",
		"dev:mcp": "bun run --cwd packages/mcp dev",
		"dev:electron": "bun run --cwd packages/electron dev",
		"cleanup:orphans": "bun ./scripts/cleanup-orphans.ts",
		"verify:server": "bun ./scripts/verify-server.ts",
		"verify:server:local": "bun ./scripts/verify-server-local.ts",
		"build:desktop": "bun run --cwd packages/desktop tauri build",
		"build:electron": "bun run --cwd packages/electron package",
		"build:app": "bun run --cwd packages/app build",
		"migrate:clean": "bun run --cwd packages/server migrate --clean"
	},
	"devDependencies": {
		"oxlint": "catalog:",
		"oxfmt": "catalog:",
		"@effect/language-service": "0.72.0",
		"@tsconfig/bun": "catalog:",
		"@types/node": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:"
	}
}
